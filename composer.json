{
    "name": "micro/plugin-oauth2-client-keycloak",
    "description": "Micro Framework: Adapter for using Keycloak as an authorization server based on the OAuth2 protocol.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Micro\\Plugin\\OAuth2\\Client\\Keycloak\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Stanislau Komar",
            "email": "stanislau_komar@epam.com"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0",
        "firebase/php-jwt": "^7.0",
        "micro/plugin-oauth2-client": "^1.6"
    },
    "require-dev": {
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.8.2 || ^8.0",
        "guzzlehttp/psr7": "^2.6.3 || ^3.0",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "@php -d error_reporting=-1 vendor/bin/phpunit"
    }
}
